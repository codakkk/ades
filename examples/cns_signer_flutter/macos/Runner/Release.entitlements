<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox off: a sandboxed app cannot dlopen vendor middleware outside
	     its container or read arbitrary user files. See ../../README.md. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hardened runtime: allow loading the vendor's (differently signed)
	     PKCS#11 dylib. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Access to CryptoTokenKit smart cards (needed by middleware that talks
	     to the card through the system PC/SC stack). -->
	<key>com.apple.security.smartcard</key>
	<true/>
</dict>
</plist>
